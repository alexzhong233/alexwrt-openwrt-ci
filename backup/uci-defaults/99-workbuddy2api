#!/bin/sh
# SPDX-License-Identifier: MIT
#
# workbuddy2api 的首次启动初始化。
#
# 上游把这几件事写在包的 postinst 里，但那只在 apk/opkg 安装时执行。
# 编进固件时，OpenWrt 在 prepare_rootfs 阶段以 IPKG_INSTROOT=<target dir>
# 跑一次 postinst，脚本里的 [ -n "$IPKG_INSTROOT" ] 守卫会直接跳过（这是对的，
# 否则会往宿主机写文件）；而设备上包已标记安装，不会再触发 postinst。
# 结果就是数据目录不存在、sysupgrade 不保留账号、缓存预热没进 cron。
#
# 所以把这些动作搬到 uci-defaults：首次启动执行一次，跑完自动删除。

# 账号与用量目录：wb_proxy 启动时未必会自己建，缺了会直接起不来
mkdir -p /etc/workbuddy2api/accounts /etc/workbuddy2api/usage
chmod 700 /etc/workbuddy2api /etc/workbuddy2api/accounts 2>/dev/null

# 配置里有面板密码，收紧权限
[ -f /etc/config/workbuddy2api ] && chmod 600 /etc/config/workbuddy2api 2>/dev/null

# 账号是 OAuth token，升级固件不能丢
touch /etc/sysupgrade.conf
grep -q '^/etc/workbuddy2api$' /etc/sysupgrade.conf 2>/dev/null || \
	echo '/etc/workbuddy2api' >> /etc/sysupgrade.conf

# 面板缓存预热。uci main.warm=0 时不装，和上游 postinst 的行为保持一致。
if [ "$(uci -q get workbuddy2api.main.warm)" != "0" ]; then
	mkdir -p /etc/crontabs
	sed -i '/workbuddy2api-warm/d' /etc/crontabs/root 2>/dev/null
	echo '*/2 * * * * /usr/bin/workbuddy2api-warm --quiet' >> /etc/crontabs/root
	/etc/init.d/cron restart >/dev/null 2>&1 || true
fi

exit 0
