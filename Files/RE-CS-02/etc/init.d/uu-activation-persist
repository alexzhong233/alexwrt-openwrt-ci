#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
#
# 让 uuplugin 的注册记录跨重启存活。
#
# 上游的 luci-app-uugamebooster 把激活记录写在 /var/tmp/uu/activate_status，
# 那是 tmpfs；重启后文件消失，而网易云端认为设备已注册、不会让插件重写一遍，
# 于是状态页永久停在"正在注册"，手机 App 却已经能绑定加速。
#
# 这个服务只在 uuplugin 启用时才创建实例：没装/没开 UU 的路由器上不占进程。

START=99
STOP=10
USE_PROCD=1

start_service() {
	# 没装 UU 或者没开，就没有需要持久化的东西。
	[ -x /usr/bin/uu-activation-persist.sh ] || return 0
	[ "$(uci -q get uuplugin.@uuplugin[0].enabled 2>/dev/null)" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/uu-activation-persist.sh watch
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
