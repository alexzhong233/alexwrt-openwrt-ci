#!/bin/sh /etc/rc.common

# 事件驱动版兼容规则守护。和 netbird-passwall-compat 二选一，
# 不要同时启用：两者共用同一把补丁锁，轮询服务会占住它。
#
#   /etc/init.d/netbird-passwall-compat-watch enable
#   /etc/init.d/netbird-passwall-compat-watch start
#
# 临时调整兜底间隔：
#   WATCHDOG=120 /etc/init.d/netbird-passwall-compat-watch restart

START=99
STOP=10
USE_PROCD=1
WATCHDOG="${WATCHDOG:-60}"

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/netbird-passwall-compat-watch.sh
	procd_set_param env WATCHDOG="$WATCHDOG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
