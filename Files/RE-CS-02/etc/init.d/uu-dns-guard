#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
#
# uu-dns-guard — 保证 UU 加速器不会劫持被加速设备的 DNS。
# 实现见 /usr/bin/uu-dns-guard.sh，本脚本只负责进程生命周期。
#
# 默认不启用：它只在「UU 与 PassWall 同时使用、且被加速设备需要正常解析」时
# 才有意义。开启方式：
#   /etc/init.d/uu-dns-guard enable && /etc/init.d/uu-dns-guard start
# 关闭：
#   /etc/init.d/uu-dns-guard stop && /etc/init.d/uu-dns-guard disable

START=99
USE_PROCD=1

PROG=/usr/bin/uu-dns-guard.sh
POLL="${UU_DNS_GUARD_POLL:-3}"

start_service() {
	[ -x "$PROG" ] || return 0

	procd_open_instance
	procd_set_param command /bin/sh "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param env UU_DNS_GUARD_POLL="$POLL"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
