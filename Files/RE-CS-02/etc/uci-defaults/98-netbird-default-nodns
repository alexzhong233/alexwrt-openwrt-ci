#!/bin/sh

# Make `netbird up` default to --disable-dns on this router.
# The original binary is kept at /usr/libexec/netbird-real. This does not
# connect, log in, or run `up` automatically.

set -u

REAL=/usr/libexec/netbird-real
CLI=/usr/bin/netbird

if [ -x "$CLI" ] && [ ! -x "$REAL" ]; then
	mkdir -p /usr/libexec
	mv "$CLI" "$REAL"
	cat > "$CLI" <<'EOF'
#!/bin/sh

REAL=/usr/libexec/netbird-real

case "${1:-}" in
	up)
		has_dns_flag=0
		for arg in "$@"; do
			case "$arg" in
				--disable-dns|--disable-dns=true|--disable-dns=false)
					has_dns_flag=1
					break
					;;
			esac
		done
		if [ "$has_dns_flag" -eq 0 ]; then
			exec "$REAL" "$@" --disable-dns
		fi
		;;
esac

exec "$REAL" "$@"
EOF
	chmod 755 "$CLI"
fi

exit 0
