#!/bin/sh

# Apply the requested first-boot Wi-Fi layout once. Existing settings are
# intentionally not touched after this script has run.
#
# @WRT_SSID@ / @WRT_WORD@ 是占位符，编译时由 Scripts/Settings.sh 用
# NIUBIALEX.yml 里的 WRT_SSID / WRT_WORD 入参替换。直接改这里的字面量没有用。

set -u

for section in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
	band=$(uci -q get "wireless.$section.band" || true)
	path=$(uci -q get "wireless.$section.path" || true)
	iface=""

	for candidate in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-iface$/\1/p"); do
		[ "$(uci -q get "wireless.$candidate.device" || true)" = "$section" ] || continue
		iface=$candidate
		break
	done

	[ -n "$iface" ] || continue

	case "$band:$path" in
		2g:*)
			uci set "wireless.$iface.ssid=@WRT_SSID@"
			uci set "wireless.$section.channel=5"
			uci set "wireless.$section.htmode=HE40"
			;;
		5g:*pci*)
			uci set "wireless.$iface.ssid=@WRT_SSID@Gaming"
			uci set "wireless.$section.channel=36"
			uci set "wireless.$section.htmode=HE160"
			;;
		5g:*)
			uci set "wireless.$iface.ssid=@WRT_SSID@"
			uci set "wireless.$section.channel=161"
			uci set "wireless.$section.htmode=HE80"
			;;
		*)
			continue
			;;
	esac

	uci set "wireless.$iface.encryption=psk2+ccmp"
	uci set "wireless.$iface.key=@WRT_WORD@"
done

uci commit wireless
wifi reload 2>/dev/null || true
exit 0
