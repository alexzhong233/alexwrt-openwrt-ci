#!/bin/sh
# SPDX-License-Identifier: MIT
#
# 兼容守护的配置初始化。
#
# 只有一个守护：事件驱动的 netbird-passwall-compat-watch。
#
#   option mode 'off'    关闭（默认）
#   option mode 'watch'  运行事件驱动守护
#
# 老固件遗留脚本和 netbird CLI 包装的清理不在这里，见 99-alexwrt-legacy-cleanup。

set -u

# 旧文件名是 /etc/config/niubialex（2026-11-08 全项目改名）。老设备勾「保留
# 配置」升级上来时，里面可能存着 mode=watch，换个文件名就读不到、回落到 off，
# 守护会静默停掉，所以先搬到新名字再谈默认值。
if [ ! -f /etc/config/alexwrt ] && [ -f /etc/config/niubialex ]; then
	mv /etc/config/niubialex /etc/config/alexwrt 2>/dev/null ||
		cp -a /etc/config/niubialex /etc/config/alexwrt 2>/dev/null
fi

if [ ! -f /etc/config/alexwrt ]; then
	cat >/etc/config/alexwrt <<'EOF'
config netbird 'compat'
	option mode 'off'
	option watchdog '60'
EOF
	uci -q commit alexwrt 2>/dev/null || true
fi

# 这个文件不是任何软件包的 conffile，sysupgrade 默认不会保留，
# 不显式加进去的话重刷固件后模式设置会回到 off。
touch /etc/sysupgrade.conf
grep -qxF '/etc/config/alexwrt' /etc/sysupgrade.conf 2>/dev/null || \
	echo '/etc/config/alexwrt' >>/etc/sysupgrade.conf
# 旧路径留着只会让每次升级多保留一个空文件，顺手去掉。
sed -i '\#^/etc/config/niubialex$#d' /etc/sysupgrade.conf 2>/dev/null || true

# 软链接与当前模式对齐：mode=watch 才留开机项，其余一律撤掉。
# 服务自己启动时也会校验 mode，这里的软链只是让 /etc/rc.d 看起来诚实。
MODE=$(uci -q get alexwrt.compat.mode 2>/dev/null)
case "${MODE:-off}" in
watch) /etc/init.d/netbird-passwall-compat-watch enable >/dev/null 2>&1 || true ;;
*) /etc/init.d/netbird-passwall-compat-watch disable >/dev/null 2>&1 || true ;;
esac

exit 0
