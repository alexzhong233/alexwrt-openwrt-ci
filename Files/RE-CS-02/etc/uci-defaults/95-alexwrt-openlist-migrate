#!/bin/sh
# openlist2 -> openlist 一次性迁移（2026-11-08 换成官方 feeds 版）。
#
# 两个包编的是同一份 OpenList 源码（4.2.9，同一个 tarball），但数据目录和 UCI
# 段名写死在各自包里：
#   sbwml/luci-app-openlist2  ->  /etc/openlist2/data.db   + /etc/config/openlist2
#   官方 openlist（feeds）    ->  /etc/openlist/data.db    + /etc/config/openlist
# 官方自带的 /etc/uci-defaults/99-migrate-openlist 只认 alist，不认 openlist2，
# 所以升级后旧数据库不会自己搬过来，这里补一次。
#
# 只搬三样，都只在「新位置还没有」时动手：
#   1. 数据目录（data.db、bleve 索引、config.json），旧目录保留不删
#   2. enabled：新包默认 enabled 0，不搬的话升级后服务是停的
#   3. 端口：旧字段叫 port，新字段叫 listen_http_port
#
# uci-defaults 的脚本是被 `( . ./文件 )` 包在子 shell 里 source 的，正常返回 0
# 才会被删掉。这里不做任何 exit，失败就让脚本留下，下次开机重试。
if [ ! -f /etc/openlist/data.db ] && [ -f /etc/openlist2/data.db ]; then
	mkdir -p /etc/openlist
	cp -a /etc/openlist2/. /etc/openlist/ 2>/dev/null
	echo "openlist: migrated /etc/openlist2 -> /etc/openlist"
fi

if command -v uci >/dev/null 2>&1; then
	if [ "$(uci -q get openlist.config.enabled)" != "1" ] &&
		[ "$(uci -q get openlist2.config.enabled)" = "1" ]; then
		uci -q set openlist.config.enabled=1 && uci -q commit openlist
		echo "openlist: kept the service enabled as in openlist2"
	fi

	OLD_PORT="$(uci -q get openlist2.config.port)"
	NEW_PORT="$(uci -q get openlist.config.listen_http_port)"
	if [ -n "$OLD_PORT" ] && [ -n "$NEW_PORT" ] && [ "$OLD_PORT" != "$NEW_PORT" ]; then
		uci -q set openlist.config.listen_http_port="$OLD_PORT" && uci -q commit openlist
		echo "openlist: migrated http port $OLD_PORT -> listen_http_port"
	fi
fi
