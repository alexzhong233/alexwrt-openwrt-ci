#!/bin/sh
# SPDX-License-Identifier: MIT
#
# /etc/config/niubialex 的首次初始化，外加两件一次性收尾。
#
# 兼容守护只有一个：事件驱动的 netbird-passwall-compat-watch。
#
#   option mode 'off'    关闭（默认）
#   option mode 'watch'  运行事件驱动守护
#
# 它还负责：
#   1. 撤掉旧固件留下的 `netbird --disable-dns` 包装，恢复原生 CLI，
#      让 LuCI 的 NetBird 走上游正常逻辑；
#   2. 清掉已废弃的辅助脚本和轮询服务，避免升级勾「保留配置」后残留执行。

set -u

if [ ! -f /etc/config/niubialex ]; then
	cat >/etc/config/niubialex <<'EOF'
config netbird 'compat'
	option mode 'off'
	option watchdog '60'
EOF
	uci -q commit niubialex 2>/dev/null || true
fi

# 这个文件不是任何软件包的 conffile，sysupgrade 默认不会保留，
# 不显式加进去的话重刷固件后模式设置会回到 off。
touch /etc/sysupgrade.conf
grep -qxF '/etc/config/niubialex' /etc/sysupgrade.conf 2>/dev/null || \
	echo '/etc/config/niubialex' >>/etc/sysupgrade.conf

# ---- 1. 恢复原生 netbird CLI ----------------------------------------------
# 旧固件把真身挪到 /usr/libexec/netbird-real，并在 /usr/bin/netbird 放了
# 一个自动追加 --disable-dns 的 shell 包装。这里反向操作一次：真身覆盖回
# /usr/bin/netbird，然后删掉中间文件。包装脚本的第一行是 #!，二进制不会是，
# 用这个特征判断，重复执行也不会误伤。
REAL=/usr/libexec/netbird-real
CLI=/usr/bin/netbird
if [ -x "$REAL" ]; then
	if [ "$(head -c 2 "$CLI" 2>/dev/null)" = '#!' ]; then
		# 复制失败就不删真身，免得最后连 netbird 命令都没有了。
		if cp -f "$REAL" "$CLI" 2>/dev/null; then
			chmod 755 "$CLI"
			rm -f "$REAL"
			logger -t niubialex-netbird "已移除 netbird --disable-dns 包装，恢复原生 CLI"
		fi
	elif [ -x "$CLI" ]; then
		# CLI 已经是正常二进制，中间文件只是残留。
		rm -f "$REAL"
	fi
fi

# ---- 2. 清理已废弃的脚本与服务 --------------------------------------------
# 新固件不再包含这些文件；升级勾「保留配置」时 overlay 会把旧副本带过来，
# 不清掉它们还会被调用（尤其是 /etc/rc.d 里的开机软链接）。
for f in \
	/etc/init.d/netbird-passwall-compat \
	/usr/bin/netbird-dns-guard.sh \
	/usr/bin/netbird-dnsmasq-wt0-fix.sh \
	/usr/bin/netbird-passwall-diagnose.sh \
	/usr/bin/netbird-passwall-lan-fix.sh; do
	[ -e "$f" ] && rm -f "$f"
done
# 只删轮询服务自己的软链接；-watch 的链接名不同，不会被误删。
for l in /etc/rc.d/S??netbird-passwall-compat /etc/rc.d/K??netbird-passwall-compat; do
	[ -e "$l" ] && rm -f "$l"
done

# ---- 3. 软链接与当前模式对齐 ----------------------------------------------
MODE=$(uci -q get niubialex.compat.mode 2>/dev/null)
case "${MODE:-off}" in
watch) /etc/init.d/netbird-passwall-compat-watch enable >/dev/null 2>&1 || true ;;
*) /etc/init.d/netbird-passwall-compat-watch disable >/dev/null 2>&1 || true ;;
esac

exit 0
