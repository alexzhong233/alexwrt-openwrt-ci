#!/bin/sh
# SPDX-License-Identifier: MIT
#
# 给 uu-state 建开机软链接：它负责把 /tmp/uu 绑到持久的 /etc/uu。
# 脚本本身不常驻，只跑一次 mount 就退出，所以这里只是 enable，不 start，
# 真正的挂载发生在下一次开机、以及 uuplugin 启动之前（START=97 < 99）。
#
# 幂等，任何一步失败都返回 0，避免被 uci_apply_defaults 留着反复重跑。

[ -x /etc/init.d/uu-state ] || exit 0
[ -f /etc/config/uuplugin ] || exit 0

/etc/init.d/uu-state enable >/dev/null 2>&1

# 首次刷入就立刻生效，不用等重启。此时 uuplugin 可能正在跑，
# 挂载会遮住它手里的文件，所以先停服务、搬完再起。
if [ "$(uci -q get uuplugin.@uuplugin[0].enabled 2>/dev/null)" = "1" ] &&
	! grep -q " /tmp/uu " /proc/mounts 2>/dev/null; then
	/etc/init.d/uuplugin stop >/dev/null 2>&1
	/etc/init.d/uu-state start >/dev/null 2>&1
	/etc/init.d/uuplugin start >/dev/null 2>&1
fi

exit 0
