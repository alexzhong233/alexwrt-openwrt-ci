#!/bin/sh
# SPDX-License-Identifier: MIT
#
# 兼容守护的配置初始化。
#
# 只有一个守护：事件驱动的 netbird-passwall-compat-watch。
#
#   option mode 'off'    关闭（默认）
#   option mode 'watch'  运行事件驱动守护
#
# 老固件遗留脚本和 netbird CLI 包装的清理不在这里，见 99-niubialex-legacy-cleanup。

set -u

if [ ! -f /etc/config/niubialex ]; then
	cat >/etc/config/niubialex <<'EOF'
config netbird 'compat'
	option mode 'off'
	option watchdog '60'
EOF
	uci -q commit niubialex 2>/dev/null || true
fi

# 这个文件不是任何软件包的 conffile，sysupgrade 默认不会保留，
# 不显式加进去的话重刷固件后模式设置会回到 off。
touch /etc/sysupgrade.conf
grep -qxF '/etc/config/niubialex' /etc/sysupgrade.conf 2>/dev/null || \
	echo '/etc/config/niubialex' >>/etc/sysupgrade.conf

# 软链接与当前模式对齐：mode=watch 才留开机项，其余一律撤掉。
# 服务自己启动时也会校验 mode，这里的软链只是让 /etc/rc.d 看起来诚实。
MODE=$(uci -q get niubialex.compat.mode 2>/dev/null)
case "${MODE:-off}" in
watch) /etc/init.d/netbird-passwall-compat-watch enable >/dev/null 2>&1 || true ;;
*) /etc/init.d/netbird-passwall-compat-watch disable >/dev/null 2>&1 || true ;;
esac

exit 0
